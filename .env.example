# ===================================================
# Society Maintenance Tracker - Environment Variables
# ===================================================

# Application Mode
VITE_APP_ENV=development
VITE_APP_NAME="Society Maintenance Tracker"

# Base API Configuration (Defaults to client-side localStorage simulation)
VITE_API_MODE=mock

# Email Notification Service Integration (Optional Free-tier providers e.g. EmailJS / Resend)
# To enable live transactional email dispatch, configure these keys:
VITE_EMAIL_PROVIDER=simulated
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_RESEND_API_KEY=
VITE_SOCIETY_ADMIN_EMAIL=admin@society.com

# Default SLA Overdue Days Threshold
VITE_DEFAULT_OVERDUE_DAYS=5
